# ==============================================================================
# PICC-PP-Kubernetes-Integration - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific values.
# Do NOT commit '.env' or real credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=8080
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=standalone
SPRING_CLOUD_CONFIG_ENABLED=false

# ------------------------------------------------------------------------------
# 2. Kubernetes Cluster API Configuration
# ------------------------------------------------------------------------------
# Target Kubernetes API server URL (e.g. https://127.0.0.1:6443 or https://kubernetes.default.svc)
K8S_URL=https://kubernetes.default.svc

# Kubernetes Service Account Bearer Token for cluster administration
K8S_MASTER_TOKEN=

# ------------------------------------------------------------------------------
# 3. NNP Dashboard / Portal Backend Configuration
# ------------------------------------------------------------------------------
# Base URL for the NNP Dashboard Service to fetch environment and namespace metadata
NNP_DASH_BASEURL=http://localhost:8082

# Host/Domain for the web terminal client websocket redirect
VAR_BASE_NNP_DOMAIN=localhost:8080

# ------------------------------------------------------------------------------
# 4. Spring Cloud Config Server (Optional)
# ------------------------------------------------------------------------------
# Set to true when deploying in a microservices mesh with Spring Cloud Config Server
# SPRING_CLOUD_CONFIG_ENABLED=true
# SPRING_CONFIG_IMPORT=optional:configserver:http://localhost:8888/
